---
const navItems = [
  { label: 'होम', labelEn: 'Home', href: '/' },
  { label: 'कथाहरू', labelEn: 'Stories', href: '/stories' },
  { label: 'नेपाल नाडी', labelEn: 'Pulse', href: '/pulse' },
  { label: 'हाम्रो बारे', labelEn: 'About', href: '/about' },
  { label: 'सँगै काम गरौँ', labelEn: 'Work with me', href: '/work-with-me' }
];
---

<nav class="sticky top-0 z-50 bg-cream/95 backdrop-blur-sm border-b border-gold/20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 shrink-0">
        <img 
          src="/images/logo-nav.png" 
          alt="लाहुरेदेखि चौरेसम्म" 
          class="h-10 w-auto"
          onerror="this.style.display='none'"
        />
        <span class="font-nepali font-bold text-charcoal text-sm sm:text-base leading-tight">
          लाहुरेदेखि<br/><span class="text-crimson">चौरेसम्म</span>
        </span>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center gap-1">
        {navItems.map(item => (
          <a 
            href={item.href}
            class="px-3 py-2 rounded-lg text-sm font-nepali font-medium text-charcoal hover:bg-navy/5 hover:text-navy transition-colors"
          >
            {item.label}
            <span class="text-xs text-muted ml-1 font-sans">{item.labelEn}</span>
          </a>
        ))}
      </div>

      <!-- Mobile Menu Button -->
      <button 
        id="mobile-menu-btn"
        class="md:hidden p-2 rounded-lg text-charcoal hover:bg-navy/5"
        aria-label="Menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-cream border-t border-gold/20">
    <div class="px-4 py-3 space-y-1">
      {navItems.map(item => (
        <a 
          href={item.href}
          class="block px-3 py-2 rounded-lg text-base font-nepali font-medium text-charcoal hover:bg-navy/5 hover:text-navy transition-colors"
        >
          {item.label}
          <span class="text-sm text-muted ml-2 font-sans">{item.labelEn}</span>
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
