---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const stories = await getCollection('stories');
  return stories.map(story => ({
    params: { slug: story.slug },
    props: { story }
  }));
}

const { story } = Astro.props;
const { Content } = await story.render();

const {
  title,
  titleEn,
  category,
  type,
  language,
  date,
  readTime,
  heroImage,
  summaryWhat,
  summaryWhy,
  summaryLesson
} = story.data;

const formattedDate = new Date(date).toLocaleDateString('ne-NP', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<Layout title={`${title} | Lahurey to Chaurey`} description={summaryWhat || title} image={heroImage}>
  <article class="bg-cream min-h-screen">
    <!-- Hero Image -->
    {heroImage ? (
      <div class="w-full aspect-video max-h-[500px] overflow-hidden">
        <img src={heroImage} alt={title} class="w-full h-full object-cover" />
      </div>
    ) : (
      <div class="w-full h-40 bg-navy/5 flex items-center justify-center border-b border-gold/10">
        <span class="text-muted text-sm">[ Hero image ]</span>
      </div>
    )}

    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10">

      <!-- Meta -->
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="text-xs font-medium text-crimson bg-crimson/5 px-3 py-1 rounded-full">{category}</span>
        <span class="text-xs text-muted">{type}</span>
        <span class="text-xs text-muted">{readTime} पढाइ</span>
        <span class="text-xs text-muted">{formattedDate}</span>
        <span class="text-xs bg-cream border border-gold/20 px-2 py-0.5 rounded text-muted">{language}</span>
      </div>

      <!-- Title -->
      <h1 class="font-nepali text-3xl sm:text-4xl font-bold text-charcoal leading-tight mb-2">
        {title}
      </h1>
      {titleEn && (
        <p class="font-sans text-lg text-muted mb-8">{titleEn}</p>
      )}

      <!-- Summary Box -->
      {(summaryWhat || summaryWhy || summaryLesson) && (
        <div class="bg-navy/5 border-l-4 border-navy rounded-r-xl p-5 sm:p-6 mb-8">
          <h2 class="font-nepali font-semibold text-navy mb-4">सारांश</h2>
          <ul class="space-y-3">
            {summaryWhat && (
              <li class="flex gap-3">
                <span class="shrink-0 w-6 h-6 bg-crimson rounded-full text-white text-xs flex items-center justify-center font-bold">१</span>
                <div>
                  <span class="font-nepali font-medium text-sm text-navy">के भयो?</span>
                  <p class="text-charcoal/80 text-sm mt-0.5">{summaryWhat}</p>
                </div>
              </li>
            )}
            {summaryWhy && (
              <li class="flex gap-3">
                <span class="shrink-0 w-6 h-6 bg-navy rounded-full text-white text-xs flex items-center justify-center font-bold">२</span>
                <div>
                  <span class="font-nepali font-medium text-sm text-navy">किन महत्त्वपूर्ण?</span>
                  <p class="text-charcoal/80 text-sm mt-0.5">{summaryWhy}</p>
                </div>
              </li>
            )}
            {summaryLesson && (
              <li class="flex gap-3">
                <span class="shrink-0 w-6 h-6 bg-gold rounded-full text-charcoal text-xs flex items-center justify-center font-bold">३</span>
                <div>
                  <span class="font-nepali font-medium text-sm text-navy">के सिकाइ होला?</span>
                  <p class="text-charcoal/80 text-sm mt-0.5">{summaryLesson}</p>
                </div>
              </li>
            )}
          </ul>
        </div>
      )}

      <!-- Main Content -->
      <div class="prose prose-lg max-w-none
        prose-headings:font-nepali prose-headings:text-charcoal
        prose-h2:text-2xl prose-h2:font-bold prose-h2:mt-10 prose-h2:mb-4
        prose-h3:text-xl prose-h3:font-semibold prose-h3:mt-8 prose-h3:mb-3
        prose-p:text-charcoal/85 prose-p:leading-relaxed prose-p:mb-5
        prose-a:text-navy prose-a:no-underline hover:prose-a:text-crimson
        prose-strong:text-charcoal prose-strong:font-semibold
        prose-ul:text-charcoal/85 prose-ol:text-charcoal/85
        prose-blockquote:border-l-4 prose-blockquote:border-gold prose-blockquote:bg-gold/5 prose-blockquote:rounded-r-lg prose-blockquote:px-4
      ">
        <Content />
      </div>

      <!-- Bottom CTA Block -->
      <div class="mt-12 pt-8 border-t border-gold/20 space-y-4">

        <!-- Like Button -->
        <div class="flex items-center gap-3">
          <button
            id="like-btn"
            class="flex items-center gap-2 px-4 py-2 rounded-full border border-crimson/30 text-crimson hover:bg-crimson hover:text-white transition-all font-nepali"
          >
            <span>❤️</span>
            <span>यो कथा मन पर्‍यो</span>
          </button>
          <span id="like-count" class="text-sm text-muted">१२ जनालाई मन पर्‍यो</span>
        </div>

        <!-- WhatsApp Share -->
        <div class="bg-green-50 border border-green-200 rounded-xl p-4 flex flex-col sm:flex-row items-start sm:items-center gap-4">
          <div>
            <p class="font-nepali font-semibold text-charcoal">यो कथा साथीलाई पठाउनुहोस्</p>
            <p class="text-sm text-muted">Share this story on WhatsApp</p>
          </div>
          <div class="flex gap-3 shrink-0">
            <a
              href={`https://wa.me/?text=${encodeURIComponent(title + " - Read on Lahurey to Chaurey")}`}
              target="_blank"
              class="inline-flex items-center gap-2 bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Share
            </a>
            <a
              href="https://whatsapp.com/channel/your-channel"
              target="_blank"
              class="inline-flex items-center gap-2 bg-white border border-green-300 text-green-700 px-4 py-2 rounded-lg text-sm font-medium transition-colors hover:bg-green-50"
            >
              च्यानल Join गर्नुहोस्
            </a>
          </div>
        </div>

        <!-- Giscus Comments -->
        <div class="mt-8">
          <h3 class="font-nepali text-lg font-semibold text-charcoal mb-4">टिप्पणी / Comments</h3>
          <script
            src="https://giscus.app/client.js"
            data-repo="YOUR_GITHUB_USERNAME/lahurey-to-chaurey"
            data-repo-id="YOUR_REPO_ID"
            data-category="Comments"
            data-category-id="YOUR_CATEGORY_ID"
            data-mapping="pathname"
            data-strict="0"
            data-reactions-enabled="1"
            data-emit-metadata="0"
            data-input-position="top"
            data-theme="light"
            data-lang="ne"
            crossorigin="anonymous"
            async
          ></script>
        </div>

        <!-- Work With Me CTA -->
        <div class="bg-cream border border-gold/20 rounded-xl p-5 text-center">
          <p class="font-nepali text-charcoal font-medium mb-2">यस्तै शैलीमा आफ्नो कथा सुनाउन चाहनुहुन्छ?</p>
          <a href="/work-with-me" class="inline-flex items-center gap-2 text-navy font-semibold hover:text-crimson transition-colors">
            सँगै काम गरौँ
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>

      </div>
    </div>
  </article>
</Layout>

<script>
  const btn = document.getElementById('like-btn');
  const count = document.getElementById('like-count');
  let liked = false;
  btn?.addEventListener('click', () => {
    liked = !liked;
    if (liked) {
      btn.classList.add('bg-crimson', 'text-white');
      count && (count.textContent = '१३ जनालाई मन पर्‍यो');
    } else {
      btn.classList.remove('bg-crimson', 'text-white');
      count && (count.textContent = '१२ जनालाई मन पर्‍यो');
    }
  });
</script>
