---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('pulse');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, category, date, summary } = post.data;
const formattedDate = new Date(date).toLocaleDateString('ne-NP', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title={`${title} | Nepal Nadi`} description={summary}>
  <article class="py-12 bg-cream">
    <div class="max-w-2xl mx-auto px-4 sm:px-6">

      <div class="flex items-center gap-2 mb-4">
        <a href="/pulse" class="text-sm text-navy hover:text-crimson flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          नेपाल नाडी
        </a>
        <span class="text-muted">/</span>
        <span class="text-xs text-muted">{category}</span>
      </div>

      <h1 class="font-nepali text-2xl sm:text-3xl font-bold text-charcoal mb-2">{title}</h1>
      <p class="text-sm text-muted mb-8">{formattedDate}</p>

      <div class="prose prose-lg max-w-none prose-headings:font-nepali prose-p:text-charcoal/85 prose-p:leading-relaxed prose-a:text-navy">
        <Content />
      </div>

      <div class="mt-10 pt-6 border-t border-gold/20 flex flex-wrap gap-4">
        <a href="/pulse" class="text-sm text-navy font-medium hover:text-crimson">← सबै पोस्टहरू</a>
        <a href="/stories" class="text-sm text-navy font-medium hover:text-crimson">गहिरा कथाहरू पढ्नुहोस् →</a>
      </div>

    </div>
  </article>
</Layout>
