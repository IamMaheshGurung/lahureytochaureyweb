---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('pulse'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title="नेपाल नाडी | Lahurey to Chaurey"
  description="छोटो विचार, ट्रेन्ड, र नेपालबारे समयानुकूल टिप्पणी।"
>
  <section class="py-12 bg-cream">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">

      <div class="mb-10">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-8 h-8 bg-crimson/10 rounded-lg flex items-center justify-center">
            <svg class="w-4 h-4 text-crimson" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <h1 class="font-nepali text-3xl font-bold text-charcoal">नेपाल नाडी</h1>
        </div>
        <p class="text-muted">Pulse — छोटा पोस्ट, ट्रेन्ड, र विचार · Short commentary & insights</p>
      </div>

      <div class="space-y-5">
        {posts.length === 0 ? (
          <div class="bg-white rounded-xl p-8 border border-gold/10 text-center">
            <p class="text-muted font-nepali">पोस्टहरू छिट्टै आउँदैछन्...</p>
            <p class="text-sm text-muted mt-1">Posts coming soon!</p>
          </div>
        ) : posts.map((post) => (
          <article class="bg-white rounded-xl p-5 sm:p-6 border border-gold/10 hover:shadow-md transition-all group">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs font-medium text-crimson bg-crimson/5 px-2 py-1 rounded-full">
                {post.data.category}
              </span>
              <span class="text-xs text-muted">
                {new Date(post.data.date).toLocaleDateString('ne-NP', { year: 'numeric', month: 'long', day: 'numeric' })}
              </span>
            </div>
            <h2 class="font-nepali text-xl font-semibold text-charcoal mb-2 group-hover:text-navy transition-colors">
              {post.data.title}
            </h2>
            <p class="text-charcoal/70 leading-relaxed text-sm">
              {post.data.summary}
            </p>
            <a
              href={`/pulse/${post.slug}`}
              class="inline-flex items-center gap-1 text-sm text-navy font-medium mt-4 hover:text-crimson transition-colors"
            >
              थप पढ्नुहोस्
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </article>
        ))}
      </div>

    </div>
  </section>
</Layout>
