---
import Layout from '../layouts/Layout.astro';

const categories = [
  { name: 'कृषि र खाद्य', nameEn: 'Agriculture & food', slug: 'agriculture' },
  { name: 'रेमिट्यान्स र लाहुरे', nameEn: 'Remittance', slug: 'remittance' },
  { name: 'स्टार्टअप र नवप्रवर्तन', nameEn: 'Startups', slug: 'startups' },
  { name: 'पर्यटन र संस्कृति', nameEn: 'Tourism', slug: 'tourism' },
  { name: 'वातावरण र ऊर्जा', nameEn: 'Environment', slug: 'environment' },
  { name: 'पूर्वाधार र विकास', nameEn: 'Infrastructure', slug: 'infrastructure' },
  { name: 'मानिस र समाज', nameEn: 'People', slug: 'people' },
  { name: 'प्रविधि र डिजिटल', nameEn: 'Tech', slug: 'tech' },
  { name: 'शिक्षा र युवा', nameEn: 'Education', slug: 'education' }
];

const latestStories = [
  {
    title: 'एक गाउँले कसरी बनायो सौर्य ऊर्जामा आत्मनिर्भर',
    titleEn: 'How one village became solar self-reliant',
    category: 'वातावरण र ऊर्जा',
    readTime: '८ मिनेट',
    date: '२०८१ चैत १५',
    slug: 'solar-village-case-study',
    featured: true
  },
  {
    title: 'जापानबाट फर्किएका युवाको कृषि स्टार्टअप',
    titleEn: 'A returnee's agri-startup from Japan experience',
    category: 'कृषि र खाद्य',
    readTime: '६ मिनेट',
    date: '२०८१ चैत १२',
    slug: 'returnee-agri-startup'
  },
  {
    title: 'रेमिट्यान्सले बदल्यो गोरखाको एउटा गाउँ',
    titleEn: 'Remittance transformed a Gorkha village',
    category: 'रेमिट्यान्स र लाहुरे',
    readTime: '१० मिनेट',
    date: '२०८१ चैत ८',
    slug: 'remittance-gorkha-village'
  },
  {
    title: 'काठमाडौंको टेक सिन र युवा उद्यमीहरू',
    titleEn: 'Kathmandu's tech scene and young founders',
    category: 'स्टार्टअप र नवप्रवर्तन',
    readTime: '५ मिनेट',
    date: '२०८१ चैत ५',
    slug: 'kathmandu-tech-founders'
  }
];

const pulsePosts = [
  {
    title: 'नेपाली एपहरूको अन्तर्राष्ट्रिय बजारमा स्थान',
    summary: 'स्थानीय एप डेभलपरहरूले अब अन्तर्राष्ट्रिय स्तरमा प्रतिस्पर्धा गर्न सक्छन्। के छ अवस्था?',
    slug: 'nepali-apps-global-market'
  },
  {
    title: 'जापानमा नेपाली कामदारको नयाँ माग',
    summary: 'स्पेसिफिक स्किल वर्कर भिसा खुल्दा नेपाली युवाहरूका लागि के अवसर खुल्छ?',
    slug: 'japan-specified-skilled-visa'
  },
  {
    title: 'हिमालयन ट्रेकिङमा नयाँ ट्रेन्डहरू',
    summary: '२०२६ मा पर्यटकहरू के खोजिरहेका छन्? इको-टुरिज्म र डिजिटल डिटक्स।',
    slug: 'trekking-trends-2026'
  }
];
---

<Layout 
  title="लाहुरेदेखि चौरेसम्म | Lahurey to Chaurey"
  description="नेपाल सानो होला, तर सम्भावना असीमित छ। Stories of Nepal's potential from remittance villages to tech startups."
>
  <!-- Hero Section -->
  <section class="relative bg-cream overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-20 left-10 w-64 h-64 bg-crimson rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 right-10 w-64 h-64 bg-navy rounded-full blur-3xl"></div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-24 relative">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6">
          <span class="inline-block w-2 h-2 bg-crimson rounded-full animate-pulse"></span>
          <span class="text-sm font-medium text-crimson tracking-wide uppercase">Now Live</span>
        </div>

        <h1 class="font-nepali text-4xl sm:text-5xl lg:text-6xl font-bold text-charcoal leading-tight mb-4">
          नेपाल सानो होला,<br/>
          <span class="text-navy">तर सम्भावना</span><br/>
          <span class="text-crimson">असीमित छ।</span>
        </h1>

        <p class="font-sans text-lg sm:text-xl text-muted mb-2">
          Nepal may be small, but the potential is unimaginable.
        </p>

        <p class="font-nepali text-base sm:text-lg text-charcoal/80 leading-relaxed mb-8 max-w-2xl">
          हामी जहाँ भए पनि, मन नेपालमै छ — देश सानो भए पनि, सम्भावना चन्द्र र सूर्य भन्दा ठूलो। 
          यहाँ हामी नेपालको भविष्य देखाउने कथाहरू खोज्छौं।
        </p>

        <div class="flex flex-wrap gap-4">
          <a 
            href="/stories" 
            class="inline-flex items-center gap-2 bg-crimson hover:bg-crimson/90 text-white px-6 py-3 rounded-lg font-nepali font-semibold text-base transition-all hover:shadow-lg"
          >
            केस स्टडी पढ्न सुरु गर्नुहोस्
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a 
            href="https://whatsapp.com/channel/your-channel" 
            target="_blank"
            class="inline-flex items-center gap-2 bg-white border-2 border-gold hover:bg-gold/5 text-charcoal px-6 py-3 rounded-lg font-nepali font-medium text-base transition-all"
          >
            <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            व्हाट्सएपमा जोडिनुहोस्
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Story -->
  <section class="py-12 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="bg-cream rounded-2xl overflow-hidden border border-gold/20">
        <div class="grid md:grid-cols-2 gap-0">
          <div class="aspect-video md:aspect-auto bg-navy/5 flex items-center justify-center">
            <div class="text-center p-8">
              <span class="inline-block px-3 py-1 bg-crimson/10 text-crimson text-sm font-medium rounded-full mb-4">
                विशेष कथा
              </span>
              <div class="w-20 h-20 bg-gold/20 rounded-full mx-auto mb-4 flex items-center justify-center">
                <svg class="w-10 h-10 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
              </div>
              <p class="text-muted text-sm">[Hero image placeholder]</p>
            </div>
          </div>
          <div class="p-6 sm:p-8 flex flex-col justify-center">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-xs font-medium text-navy bg-navy/5 px-2 py-1 rounded">वातावरण र ऊर्जा</span>
              <span class="text-xs text-muted">८ मिनेट पढाइ</span>
            </div>
            <h2 class="font-nepali text-2xl sm:text-3xl font-bold text-charcoal mb-3">
              एक गाउँले कसरी बनायो सौर्य ऊर्जामा आत्मनिर्भर
            </h2>
            <p class="font-sans text-muted mb-4">
              How one village became solar self-reliant
            </p>
            <p class="text-charcoal/70 leading-relaxed mb-6">
              म्याग्दीको एउटा गाउँले ५ वर्षमा १००% सौर्य ऊर्जामा जान्छ। यो कसरी सम्भव भयो? स्थानीय युवाहरूको नेतृत्व, सरकारी अनुदान, र जापानी प्रविधिको मिश्रण...
            </p>
            <div class="flex items-center justify-between">
              <span class="text-2xl font-bold text-crimson">१००%</span>
              <span class="text-sm text-muted">सौर्य ऊर्जा आत्मनिर्भर</span>
            </div>
            <a 
              href="/stories/solar-village-case-study"
              class="mt-6 inline-flex items-center gap-2 text-navy font-semibold hover:text-crimson transition-colors"
            >
              पूरा कथा पढ्नुहोस्
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Category Strip -->
  <section class="py-8 bg-cream border-y border-gold/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h3 class="font-nepali text-sm font-semibold text-muted mb-4 uppercase tracking-wide">विषयहरू</h3>
      <div class="flex gap-3 overflow-x-auto pb-2 scrollbar-hide">
        {categories.map(cat => (
          <a 
            href={`/stories?category=${cat.slug}`}
            class="shrink-0 px-4 py-2 bg-white border border-gold/20 rounded-full text-sm font-nepali font-medium text-charcoal hover:bg-navy hover:text-white hover:border-navy transition-all"
          >
            {cat.name}
            <span class="text-xs text-muted ml-1 font-sans">{cat.nameEn}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest Stories -->
  <section class="py-12 bg-cream">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="font-nepali text-2xl sm:text-3xl font-bold text-charcoal">नयाँ कथाहरू</h2>
          <p class="text-muted mt-1">Latest stories and case studies</p>
        </div>
        <a href="/stories" class="hidden sm:inline-flex items-center gap-1 text-navy font-medium hover:text-crimson transition-colors">
          सबै हेर्नुहोस्
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {latestStories.map(story => (
          <article class="bg-white rounded-xl overflow-hidden border border-gold/10 hover:shadow-lg transition-shadow group">
            <div class="aspect-video bg-navy/5 flex items-center justify-center">
              <div class="w-12 h-12 bg-gold/20 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                </svg>
              </div>
            </div>
            <div class="p-4">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-xs font-medium text-crimson bg-crimson/5 px-2 py-0.5 rounded">{story.category}</span>
                <span class="text-xs text-muted">{story.readTime}</span>
              </div>
              <h3 class="font-nepali font-semibold text-charcoal leading-snug mb-1 group-hover:text-navy transition-colors">
                {story.title}
              </h3>
              <p class="text-xs text-muted font-sans">{story.titleEn}</p>
              <p class="text-xs text-muted mt-2">{story.date}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-6 text-center sm:hidden">
        <a href="/stories" class="inline-flex items-center gap-1 text-navy font-medium">
          सबै कथाहरू हेर्नुहोस्
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Nepal Nadi (Pulse) Preview -->
  <section class="py-12 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex items-center gap-3 mb-8">
        <div class="w-10 h-10 bg-crimson/10 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-crimson" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        <div>
          <h2 class="font-nepali text-2xl font-bold text-charcoal">नेपाल नाडी</h2>
          <p class="text-sm text-muted">Pulse — quick insights and commentary</p>
        </div>
      </div>

      <div class="grid sm:grid-cols-3 gap-6">
        {pulsePosts.map(post => (
          <article class="border-l-4 border-gold pl-4 py-2 hover:border-crimson transition-colors">
            <h3 class="font-nepali font-semibold text-charcoal mb-2 hover:text-navy cursor-pointer">
              {post.title}
            </h3>
            <p class="text-sm text-charcoal/70 leading-relaxed">
              {post.summary}
            </p>
            <a href={`/pulse/${post.slug}`} class="inline-flex items-center gap-1 text-sm text-navy font-medium mt-3 hover:text-crimson">
              थप पढ्नुहोस्
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </article>
        ))}
      </div>

      <div class="mt-8 text-center">
        <a href="/pulse" class="inline-flex items-center gap-2 text-navy font-semibold hover:text-crimson transition-colors">
          नेपाल नाडीका सबै पोस्टहरू
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Mission / About Teaser -->
  <section class="py-16 bg-navy text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <img 
        src="/images/logo-nav.png" 
        alt="" 
        class="h-16 w-auto mx-auto mb-6 opacity-80"
        onerror="this.style.display='none'"
      />
      <h2 class="font-nepali text-2xl sm:text-3xl font-bold mb-4">
        जहाँ भए पनि, मन नेपालमै छ
      </h2>
      <p class="text-lg text-white/80 leading-relaxed mb-6 max-w-2xl mx-auto">
        म महेश गुरुङ, टोकियोबाट। नेपालको गाउँबाट जापानसम्मको यात्राले मलाई सिकायो — हाम्रो देश सानो भए पनि, सम्भावना चन्द्र र सूर्य भन्दा ठूलो। यो साइट त्यही सम्भावनाका कथाहरू खोज्न बनाइएको हो।
      </p>
      <p class="text-white/60 font-sans mb-8">
        Mahesh Gurung, from a Nepali village to Tokyo. Documenting Nepal's potential, one story at a time.
      </p>
      <a 
        href="/about" 
        class="inline-flex items-center gap-2 bg-gold hover:bg-gold/90 text-charcoal px-6 py-3 rounded-lg font-nepali font-semibold transition-all"
      >
        हाम्रो बारेमा थप जानकारी
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- Work With Me Teaser -->
  <section class="py-12 bg-cream">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="bg-white rounded-2xl p-6 sm:p-8 border border-gold/20 text-center">
        <div class="w-12 h-12 bg-navy/10 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
        </div>
        <h2 class="font-nepali text-xl sm:text-2xl font-bold text-charcoal mb-3">
          आफ्नो कथा यहाँ सुनाउनुहोस्
        </h2>
        <p class="text-charcoal/70 leading-relaxed mb-2 max-w-xl mx-auto">
          ब्रान्ड, कम्पनी, वा NGO हरू — यदि तपाईंको काम नेपालको भविष्य देखाउँछ भने, हामी तपाईंको कथा भरोसायोग्य र प्रभावकारी तरिकाले भन्न सक्छौं।
        </p>
        <p class="text-sm text-muted font-sans mb-6">
          Brands, companies, NGOs — if your work shows Nepal's future, we can tell your story with trust and impact.
        </p>
        <a 
          href="/work-with-me" 
          class="inline-flex items-center gap-2 bg-navy hover:bg-navy/90 text-white px-6 py-3 rounded-lg font-nepali font-semibold transition-all"
        >
          सँगै काम गरौँ
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
